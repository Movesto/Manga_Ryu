# ── Local development environment variables ───────────────────────────────────
# Copy this file to backend/.env and fill in the values.
# NEVER commit backend/.env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://manga:manga@localhost:5432/manga_db

# ── Suwayomi ─────────────────────────────────────────────────────────────────
# URL of the running Suwayomi server (default: http://127.0.0.1:4567)
SUWAYOMI_URL=http://127.0.0.1:4567

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# REQUIRED — secret key for signing JWTs (server will refuse to start if missing)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Access token lifetime in minutes (default: 30 — kept short; the frontend
# renews sessions transparently via the refresh token)
ACCESS_TOKEN_MINUTES=30

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_DAYS=30

# ── Kindle conversion (optional) ─────────────────────────────────────────────
# Absolute path to the kcc-c2e binary.
# Leave empty to disable Kindle EPUB download feature.
KCC_PATH=

# ── ML genre tagger (optional) ───────────────────────────────────────────────
# Directory containing the trained model (ml/train_tagger.py output).
# Defaults to ../ml/model relative to the backend source tree.
TAGGER_MODEL_DIR=
# Prediction confidence cutoff, 0–1 (default: 0.30)
TAGGER_THRESHOLD=0.30
