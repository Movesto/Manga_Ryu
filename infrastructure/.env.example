# ── Docker Compose environment variables ──────────────────────────────────────
# Copy this file to infrastructure/.env and fill in the values.
# NEVER commit infrastructure/.env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name (default: manga_db)
POSTGRES_DB=manga_db

# Database user (default: manga)
POSTGRES_USER=manga

# REQUIRED — database password (no default, must be set)
# Generate: openssl rand -hex 24
# (hex only — this value is interpolated into DATABASE_URL, and base64's
#  '/', '+', '=' characters would corrupt the URL)
POSTGRES_PASSWORD=

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# REQUIRED — secret key for signing JWTs (no default, crash on missing)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Access token lifetime in minutes (default: 30 — the frontend renews
# sessions transparently via the refresh token)
ACCESS_TOKEN_MINUTES=30

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_DAYS=30

# ── Kindle conversion (optional) ─────────────────────────────────────────────
# Absolute path to kcc-c2e binary inside the container.
# Leave empty to disable Kindle EPUB download feature.
KCC_PATH=

# ── Production (docker-compose.prod.yml only) ────────────────────────────────
# REQUIRED in prod — Cloudflare Tunnel token.
# Cloudflare Zero Trust dashboard → Networks → Tunnels → create/select tunnel
# → the token from the "install connector" command.
TUNNEL_TOKEN=

# GHCR image tag to deploy (default: latest). Set to a commit SHA to pin.
IMAGE_TAG=latest

# ── Observability (optional) ─────────────────────────────────────────────────
# Everything below is opt-in: leave a value blank and that integration stays
# off. After adding keys, apply with:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d

# Sentry error tracking (hosted sentry.io — self-hosted Sentry needs 4 GB+).
# Create two projects (or reuse one) and paste their DSNs.
#   Backend  → FastAPI project → Settings → Client Keys (DSN)
SENTRY_DSN=
#   Frontend → Browser/Node project DSN (this value reaches the browser; a
#   Sentry DSN is public/safe to expose)
SENTRY_DSN_FRONTEND=
# Shared tuning
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Netdata Cloud — stream metrics off-box so the agent stays lean.
# app.netdata.cloud → your Space → Connect Nodes → Docker → copy the token
# and the room id(s) from the claim command.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=
NETDATA_CLAIM_URL=https://app.netdata.cloud
# Node name shown in Netdata Cloud (default: manga-ryu)
NETDATA_HOSTNAME=manga-ryu
