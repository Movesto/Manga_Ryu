# ── Docker Compose environment variables ──────────────────────────────────────
# Copy this file to infrastructure/.env and fill in the values.
# NEVER commit infrastructure/.env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Database name (default: manga_db)
POSTGRES_DB=manga_db

# Database user (default: manga)
POSTGRES_USER=manga

# REQUIRED — database password (no default, must be set)
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── JWT / Sessions ────────────────────────────────────────────────────────────
# REQUIRED — secret key for signing JWTs (no default, crash on missing)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Access token lifetime in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_MINUTES=10080

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_DAYS=30

# ── Kindle conversion (optional) ─────────────────────────────────────────────
# Absolute path to kcc-c2e binary inside the container.
# Leave empty to disable Kindle EPUB download feature.
KCC_PATH=
